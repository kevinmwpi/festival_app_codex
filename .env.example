SUPABASE_URL=https://lzxewkfxdibohzqbqmiu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mobile / Expo public runtime vars
EXPO_PUBLIC_SUPABASE_URL=https://lzxewkfxdibohzqbqmiu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

