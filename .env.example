# Admin tools / server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-side-key
# Optional alias if you prefer newer naming in Railway variables.
# SUPABASE_SECRET_KEY=your-server-side-key

# Mobile / Expo public runtime vars
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase's newer mobile template name also works in this repo.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
#EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
