{
  "expo": {
    "name": "Festie",
    "slug": "festie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "festivalapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F6FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.festieapp.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Festie uses your location to show your position on the festival map and help friends find you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Festie tracks your location in the background to share with your group and log stage visits.",
        "NSCameraUsageDescription": "Festie needs camera access to take totem photos for meetup coordination."
      }
    },
    "android": {
      "package": "com.festieapp.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F0F6FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Festie to use your location to share with your group."
        }
      ]
    ],
    "extra": {
      "defaultFestivalId": "11111111-1111-4111-8111-111111111111",
      "eas": {
        "projectId": "festie"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
