{
  "name": "festival-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:mobile-workspace-deps": "npm run build:workspace-deps -w @festival/mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "postinstall": "npm run build:mobile-workspace-deps",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "db:test": "bash scripts/db-test.sh",
    "supabase:db:pull:linked": "supabase db pull --linked",
    "supabase:db:diff:linked": "supabase db diff --linked --schema public,storage",
    "supabase:functions:serve": "supabase functions serve",
    "supabase:functions:deploy": "supabase functions deploy delete-account && supabase functions deploy demo-login",
    "admin": "npm run --workspace=@festival/admin-tools cli --"
  },
  "devDependencies": {
    "@react-native-community/netinfo": "11.5.2",
    "@types/node": "^22.14.1",
    "supabase": "^2.84.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-native": "0.83.4"
  }
}
