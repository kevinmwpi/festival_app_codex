{
  "name": "festival-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@festival/admin-tools",
    "build:mobile-workspace-deps": "npm run build:workspace-deps -w @festival/mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "postinstall": "npm run build:mobile-workspace-deps",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "supabase:db:test": "supabase test db",
    "supabase:db:pull:linked": "supabase db pull --linked",
    "supabase:db:diff:linked": "supabase db diff --linked --schema public,storage",
    "supabase:functions:serve": "supabase functions serve",
    "supabase:functions:deploy": "supabase functions deploy create_group_invite && supabase functions deploy join_group_from_invite && supabase functions deploy upload_totem_photo",
    "supabase:seed:festival": "npx ts-node apps/admin-tools/src/seed-festival.ts seed-data/sample-festival.json"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
